OPENAI_API_KEY=replace-with-your-provider-api-key
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=meta/llama-3.2-11b-vision-instruct

# Required to change rules or reference data (at least 16 characters). Unset = admin changes disabled.
CLAIMGUARD_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Rule drafting, with the tested settings: Nemotron writing rule sheets only (no full-language manual).
RULE_DRAFTER_MODEL=nvidia/nemotron-3-super-120b-a12b
RULE_FULL_LANGUAGE_FALLBACK=false

# Every other setting has a default in the code; see docs/RULE_ENGINE.md, "Configuration", to change one.

# Evidence retrieval: optional embedding re-ranker (lexical retrieval works without it)
# EVIDENCE_EMBEDDINGS=true
# EVIDENCE_EMBEDDING_MODEL=text-embedding-3-small
