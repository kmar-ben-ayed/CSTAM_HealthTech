OPENAI_API_KEY=replace-with-your-provider-api-key
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=meta/llama-3.2-11b-vision-instruct

# Required to change rules or reference data (at least 16 characters). Unset = admin changes disabled.
CLAIMGUARD_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Rule authoring. A stronger instruction-following model is recommended for the drafter,
# and a different model for the oracle, so the two readings do not share blind spots.
RULE_DRAFTER_MODEL=
RULE_ORACLE_MODEL=
RULE_REQUIRE_AUTHOR_CONFIRMATION=true
RULE_DRAFTS_PER_HOUR=20
