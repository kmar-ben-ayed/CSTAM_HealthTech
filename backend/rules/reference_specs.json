                  "config": "policy",
                  "get": [
                    "max_unit_price",
                    {
                      "path": "$line/service_code"
                    }
                  ]
                }
              },
              {
                "let": "max_quantity",
                "be": {
                  "config": "policy",
                  "get": [
                    "max_quantity_per_line",
                    {
                      "path": "$line/service_code"
                    }
                  ]
                }
              },
              {
                "need": {
                  "op": "all_of",
                  "items": [
                    {
                      "op": "is_present",
                      "value": {
                        "path": "$line/quantity"
                      }
                    },
                    {
                      "op": "is_present",
                      "value": {
                        "path": "$line/unit_price"
                      }
                    },
                    {
                      "op": "is_present",
                      "value": {
                        "path": "$max_price"
                      }
                    },
                    {
                      "op": "is_present",
                      "value": {
                        "path": "$max_quantity"
                      }
                    }
                  ]
                },
                "note": "quantity, unit price and the policy limits are known"
              },
              {
                "require": {
                  "op": "all_of",
                  "items": [
                    {
                      "op": "is_whole_number",
                      "value": {
                        "path": "$line/quantity"
                      }
                    },
                    {
                      "op": "greater_than",
                      "left": {
                        "path": "$line/quantity"
                      },
                      "right": {
                        "value": 0
                      }
                    },
                    {
                      "op": "greater_than",
                      "left": {
                        "path": "$line/unit_price"
                      },
                      "right": {
                        "value": 0
                      }
                    },
                    {
                      "op": "at_most",
                      "left": {
                        "path": "$line/unit_price"
                      },
                      "right": {
                        "path": "$max_price"
                      }
                    },
                    {
                      "op": "at_most",
                      "left": {
                        "path": "$line/quantity"
                      },
                      "right": {
                        "path": "$max_quantity"
                      }
                    }
                  ]
                },
                "otherwise": "FAIL",
                "note": "quantity is a positive whole number within the limit, and unit price is positive and within the limit"
              }
            ]
          }
        ],
        "messages": {
          "PASS": "All quantities and unit prices are within policy limits.",
          "FAIL": "Quantity or unit price limits are violated.",
          "UNABLE_TO_ASSESS": "Missing inputs prevent a complete quantity and price limit check.",
          "NOT_APPLICABLE": "This rule does not apply to the claim."
        }
      }
    },
    "R014": {
      "logic_sha256": "5102576176485c22e911e419e967b20625830424a0b1b9d97e5952a5ed8e308e",
      "spec": {
        "language_version": 2,
        "steps": [
          {
            "need": {
              "op": "is_present",
              "value": {
                "config": "policy",
                "get": [
                  "submission_window_days"
                ]
              }
            },
            "note": "the policy has a submission window"
          },
          {
            "let": "latest_service",
            "be": {
              "latest": {
                "path": "/lines"
              },
              "as": "line",
              "of": {
                "path": "$line/service_date"
              }
            }
          },
          {
            "let": "lag",
            "be": {
              "days_between": [
                {
                  "path": "$latest_service"
                },
                {
                  "path": "/submission_date"
                }
              ]
            }
          },
          {
            "need": {
              "op": "is_present",
              "value": {
                "path": "$lag"
              }
            },
            "note": "all service dates and the submission date are valid"
          },
          {
            "only_if": {
              "op": "at_least",
              "left": {
                "path": "$lag"
              },
              "right": {
                "value": 0
              }
            },
            "note": "submission is not before the latest service (R002 handles that)"
          },
          {
            "require": {
              "op": "at_most",
              "left": {
                "path": "$lag"
              },
              "right": {
                "config": "policy",
                "get": [
                  "submission_window_days"
                ]
              }
            },
            "otherwise": "FAIL",
            "note": "days from the latest service to submission are within the window"
          }
        ],
        "messages": {
          "PASS": "The claim was submitted within the policy submission window.",
          "FAIL": "The claim was submitted outside the policy submission window.",
          "UNABLE_TO_ASSESS": "Missing or invalid dates, or an unavailable policy, prevent a submission window check.",
          "NOT_APPLICABLE": "Submission precedes the latest service date; chronology is handled by R002."
        }
      }
    },
    "R015": {
      "logic_sha256": "60fea49da1aa982d1520f99442695521b41f3e415acfead77f342a6a4a5d3218",
      "spec": {
        "language_version": 2,
        "steps": [
          {
            "need": {
              "op": "is_present",
              "value": {
                "config": "policy",
                "get": [
                  "currency"
                ]
              }
            },
            "note": "the policy currency is known"
          },
          {
            "need": {
              "op": "is_present",
              "value": {
                "path": "/currency"
              }
            },
            "note": "the claim currency is given"
          },
          {
            "require": {
              "op": "equals",
              "left": {
                "path": "/currency"
              },
              "right": {
                "config": "policy",
                "get": [
                  "currency"
                ]
              }
            },
            "otherwise": "FAIL",
            "note": "the claim currency matches the policy currency"
          }
        ],
        "messages": {
          "PASS": "Declared currency matches policy currency.",
          "FAIL": "Declared currency does not match policy currency.",
          "UNABLE_TO_ASSESS": "Policy or currency is unavailable.",
          "NOT_APPLICABLE": "This rule does not apply to the claim."
        }
      }
    }
  }
}
