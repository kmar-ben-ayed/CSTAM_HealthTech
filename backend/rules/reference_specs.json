    "R006": {
      "logic_sha256": "7f33550fd2a1f9217e94f0e2808e2e6d4708490984ebf7d1cdbff394593b9741",
      "spec": {
        "language_version": 2,
        "steps": [
          {
            "require": {
              "op": "unique",
              "collection": {
                "path": "/lines"
              },
              "as": "line",
              "by": [
                {
                  "path": "$line/service_code"
                },
                {
                  "path": "$line/service_date"
                },
                {
                  "first_present": [
                    {
                      "path": "$line/modifier"
                    },
                    {
                      "value": "(none)"
                    }
                  ]
                }
              ]
            },
            "otherwise": "FAIL",
            "note": "no two lines share service code, service date and modifier"
          }
        ],
        "messages": {
          "PASS": "No duplicate service/date/modifier combinations.",
          "FAIL": "Possible duplicate lines require review.",
          "UNABLE_TO_ASSESS": "Missing inputs prevent a complete duplicate check.",
          "NOT_APPLICABLE": "This rule does not apply to the claim."
        }
      }
    },
    "R007": {
      "logic_sha256": "557bc9ce1fb4ce444246fa632c1429f0d920b4ed9ecb54fe3ec54503cdd528f7",
      "spec": {
        "language_version": 2,
        "steps": [
          {
            "for_each": {
              "path": "/lines"
            },
            "as": "line",
            "steps": [
              {
                "require": {
                  "op": "amounts_match",
                  "left": {
                    "multiply": [
                      {
                        "path": "$line/quantity"
                      },
                      {
                        "path": "$line/unit_price"
                      }
                    ]
                  },
                  "right": {
                    "path": "$line/net_amount"
                  },
                  "tolerance": 0.01
                },
                "otherwise": "FAIL",
                "note": "net amount equals quantity times unit price"
              }
            ]
          }
        ],
        "messages": {
          "PASS": "All net amounts are correct.",
          "FAIL": "Net amount does not equal quantity * unit price for some lines.",
          "UNABLE_TO_ASSESS": "Missing numeric inputs prevent a complete arithmetic check.",
          "NOT_APPLICABLE": "This rule does not apply to the claim."
        }
      }
    },
    "R008": {
      "logic_sha256": "4b0be20979706ded805576cd84bfbca5a551258496b5f879b80db3bf2978f192",
      "spec": {
