    "R001": {
      "logic_sha256": "a0baed130ad1c2a2b0dabfe2a391ac54de876814f34518bedcd85ef5c5775413",
      "spec": {
        "language_version": 2,
        "steps": [
          {
            "require": {
              "op": "all_of",
              "items": [
                {
                  "op": "is_present",
                  "value": {
                    "path": "/invoice_number"
                  }
                },
                {
                  "op": "is_present",
                  "value": {
                    "path": "/member_id"
                  }
                },
                {
                  "op": "is_present",
                  "value": {
                    "path": "/diagnosis_code"
                  }
                }
              ]
            },
            "otherwise": "FAIL",
            "note": "invoice number, member id and diagnosis code are present"
          },
          {
            "for_each": {
              "path": "/lines"
            },
            "as": "line",
            "steps": [
              {
                "require": {
                  "op": "all_of",
                  "items": [
                    {
                      "op": "is_present",
                      "value": {
                        "path": "$line/service_date"
                      }
                    },
                    {
                      "op": "is_present",
                      "value": {
                        "path": "$line/service_code"
                      }
                    },
                    {
                      "op": "is_present",
                      "value": {
                        "path": "$line/quantity"
                      }
                    },
                    {
                      "op": "is_present",
                      "value": {
                        "path": "$line/unit_price"
                      }
                    },
                    {
                      "op": "is_present",
                      "value": {
                        "path": "$line/net_amount"
                      }
                    }
                  ]
                },
                "otherwise": "FAIL",
                "note": "every line has a service date, service code, quantity, unit price and net amount"
              }
            ]
          }
        ],
        "messages": {
          "PASS": "Required information is present.",
          "FAIL": "Required information is missing.",
          "UNABLE_TO_ASSESS": "Required information could not be checked.",
          "NOT_APPLICABLE": "This rule does not apply to the claim."
        }
      }
    },
    "R002": {
      "logic_sha256": "30a969dc47bc4ccb2824578b39e261cb7b6378afb0f4e00c191cb5826c26db91",
      "spec": {
        "language_version": 2,
        "steps": [
          {
            "for_each": {
              "path": "/lines"
            },
            "as": "line",
            "steps": [
              {
                "require": {
                  "op": "on_or_before",
                  "left": {
                    "path": "$line/service_date"
                  },
                  "right": {
                    "path": "/submission_date"
                  }
                },
                "otherwise": "FAIL",
                "note": "the service date is on or before the submission date"
              }
            ]
          }
        ],
        "messages": {
          "PASS": "All service dates are on or before the submission date.",
          "FAIL": "A service date is after the submission date.",
          "UNABLE_TO_ASSESS": "A service date or the submission date is missing or invalid.",
          "NOT_APPLICABLE": "This rule does not apply to the claim."
        }
      }
    },
    "R003": {
      "logic_sha256": "9026043043e30db62a1b6ee25b24212d08d76990386e2720736ddd802ec66cf1",
      "spec": {
        "language_version": 2,
        "steps": [
          {
