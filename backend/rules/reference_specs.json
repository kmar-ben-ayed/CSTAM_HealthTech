    "R010": {
      "logic_sha256": "2f65278c2578bd5bcd55ece5d48b851392bdb65eac120d8cc561eb028ea99f67",
      "spec": {
        "language_version": 2,
        "steps": [
          {
            "need": {
              "op": "is_present",
              "value": {
                "config": "policy",
                "get": [
                  "required_documents"
                ]
              }
            },
            "note": "the policy lists required documents"
          },
          {
            "for_each": {
              "path": "/lines"
            },
            "as": "line",
            "steps": [
              {
                "need": {
                  "op": "in",
                  "value": {
                    "path": "$line/service_code"
                  },
                  "collection": {
                    "config": "services",
                    "get": []
                  }
                },
                "note": "the service code is known"
              },
              {
                "let": "required_type",
                "be": {
                  "config": "policy",
                  "get": [
                    "required_documents",
                    {
                      "path": "$line/service_code"
                    }
                  ]
                }
              },
              {
                "only_if": {
                  "op": "is_present",
                  "value": {
                    "path": "$required_type"
                  }
                },
                "note": "the service requires a document"
              },
              {
                "need": {
                  "op": "is_present",
                  "value": {
                    "path": "$line/service_date"
                  }
                },
                "note": "the service date is known"
              },
              {
                "require": {
                  "op": "exists",
                  "collection": {
                    "path": "/attachments"
                  },
                  "as": "doc",
                  "where": {
                    "op": "all_of",
                    "items": [
                      {
                        "op": "equals",
                        "left": {
                          "path": "$doc/type"
                        },
                        "right": {
                          "path": "$required_type"
                        }
                      },
                      {
                        "op": "equals",
                        "left": {
                          "path": "$doc/patient_id"
                        },
                        "right": {
                          "path": "/patient_id"
                        }
                      },
                      {
                        "op": "equals",
                        "left": {
                          "path": "$doc/service_code"
                        },
                        "right": {
                          "path": "$line/service_code"
                        }
                      },
                      {
                        "op": "same_day",
                        "left": {
                          "path": "$doc/service_date"
                        },
                        "right": {
                          "path": "$line/service_date"
                        }
                      }
                    ]
                  }
                },
                "otherwise": "FAIL",
                "note": "a matching document of the required type is attached"
              },
              {
                "require": {
                  "op": "exists",
                  "collection": {
                    "path": "/attachments"
                  },
                  "as": "doc",
                  "where": {
                    "op": "all_of",
                    "items": [
                      {
                        "op": "equals",
                        "left": {
                          "path": "$doc/type"
                        },
                        "right": {
                          "path": "$required_type"
                        }
                      },
                      {
                        "op": "equals",
                        "left": {
                          "path": "$doc/patient_id"
                        },
                        "right": {
                          "path": "/patient_id"
                        }
                      },
                      {
                        "op": "equals",
                        "left": {
                          "path": "$doc/service_code"
                        },
                        "right": {
                          "path": "$line/service_code"
                        }
                      },
                      {
                        "op": "same_day",
                        "left": {
                          "path": "$doc/service_date"
                        },
                        "right": {
                          "path": "$line/service_date"
                        }
                      },
                      {
                        "op": "equals",
                        "left": {
                          "path": "$doc/document_status"
                        },
                        "right": {
                          "value": "final"
                        }
                      }
                    ]
                  }
                },
                "otherwise": "UNABLE_TO_ASSESS",
                "note": "at least one matching document is final (drafts cannot be assessed)"
              }
            ]
          }
        ],
        "messages": {
          "PASS": "All required supporting documents match and are final.",
          "FAIL": "Required supporting documentation is absent or does not match some lines.",
          "UNABLE_TO_ASSESS": "Matching supporting documents are present but none is confirmed final, or required comparison data is unavailable.",
          "NOT_APPLICABLE": "No supplied lines require supporting documentation under the policy."
        }
      }
    },
