        "messages": {
          "PASS": "All service dates are within active coverage, including boundaries.",
          "FAIL": "Coverage is not active or a service date is outside the coverage period.",
          "UNABLE_TO_ASSESS": "Coverage status, coverage dates or a service date is missing.",
          "NOT_APPLICABLE": "This rule does not apply to the claim."
