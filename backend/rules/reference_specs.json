              }
            ]
          }
        ],
        "messages": {
          "PASS": "All authorization-required services have nonempty authorization references.",
          "FAIL": "Required authorization reference is missing for some lines.",
          "UNABLE_TO_ASSESS": "Unknown or missing service codes, or an unavailable policy, prevent a complete authorization reference check.",
          "NOT_APPLICABLE": "No supplied lines require authorization under the policy."
        }
      }
    },
    "R009": {
      "logic_sha256": "b2213d76b3248c432c6a57fe20dfd95a124c1c568e113c9bc132137a165005ba",
      "spec": {
        "language_version": 2,
        "steps": [
          {
            "need": {
              "op": "is_present",
              "value": {
                "config": "policy",
                "get": [
                  "auth_required_services"
                ]
              }
            },
            "note": "the policy lists authorization-required services"
          },
          {
            "only_if": {
              "op": "greater_than",
              "left": {
                "count": {
                  "config": "policy",
                  "get": [
                    "auth_required_services"
                  ]
                }
              },
              "right": {
                "value": 0
              }
            },
            "note": "the policy requires authorization for at least one service"
          },
          {
            "for_each": {
              "path": "/lines"
            },
            "as": "line",
            "steps": [
              {
                "need": {
                  "op": "in",
                  "value": {
                    "path": "$line/service_code"
                  },
                  "collection": {
                    "config": "services",
                    "get": []
                  }
                },
                "note": "the service code is known"
              },
              {
                "only_if": {
                  "op": "in",
                  "value": {
                    "path": "$line/service_code"
                  },
                  "collection": {
                    "config": "policy",
                    "get": [
                      "auth_required_services"
                    ]
                  }
                },
                "note": "the service requires authorization"
              },
              {
                "need": {
                  "op": "is_present",
                  "value": {
                    "path": "$line/authorization_id"
                  }
                },
                "note": "the line has an authorization reference (checked by R008)"
              },
              {
                "need": {
                  "op": "at_most",
                  "left": {
                    "count": {
                      "path": "/authorizations"
                    },
                    "as": "candidate",
                    "where": {
                      "op": "equals",
                      "left": {
                        "path": "$candidate/authorization_id"
                      },
                      "right": {
                        "path": "$line/authorization_id"
                      }
                    }
                  },
                  "right": {
                    "value": 1
                  }
                },
                "note": "the reference is unambiguous (no two authorization records share this id)"
              },
              {
                "let": "auth",
                "be": {
                  "find": {
                    "path": "/authorizations"
                  },
                  "as": "candidate",
                  "where": {
                    "op": "equals",
                    "left": {
                      "path": "$candidate/authorization_id"
                    },
                    "right": {
                      "path": "$line/authorization_id"
                    }
                  }
                }
              },
              {
                "require": {
                  "op": "is_present",
                  "value": {
                    "path": "$auth"
                  }
                },
                "otherwise": "FAIL",
                "note": "the referenced authorization exists"
              },
              {
                "require": {
                  "op": "equals",
                  "left": {
                    "path": "$auth/patient_id"
                  },
                  "right": {
                    "path": "/patient_id"
                  }
                },
                "otherwise": "FAIL",
                "note": "the authorization is for this patient"
              },
              {
                "require": {
                  "op": "equals",
                  "left": {
                    "path": "$auth/service_code"
                  },
                  "right": {
                    "path": "$line/service_code"
                  }
                },
                "otherwise": "FAIL",
                "note": "the authorization is for this service"
              },
              {
                "require": {
                  "op": "equals",
                  "left": {
                    "path": "$auth/status"
                  },
                  "right": {
                    "value": "approved"
                  }
                },
                "otherwise": "FAIL",
                "note": "the authorization is approved"
              },
              {
                "require": {
                  "op": "within_dates",
                  "value": {
                    "path": "$line/service_date"
                  },
                  "from": {
                    "path": "$auth/valid_from"
                  },
                  "to": {
                    "path": "$auth/valid_to"
                  }
                },
                "otherwise": "FAIL",
                "note": "the service date is within the authorization period"
              },
              {
                "require": {
                  "op": "at_most",
                  "left": {
                    "sum": {
                      "path": "/lines"
                    },
                    "as": "other",
                    "of": {
                      "path": "$other/quantity"
                    },
                    "where": {
                      "op": "equals",
                      "left": {
                        "path": "$other/authorization_id"
                      },
                      "right": {
                        "path": "$line/authorization_id"
                      }
                    }
                  },
                  "right": {
                    "path": "$auth/max_quantity"
                  }
                },
                "otherwise": "FAIL",
                "note": "total quantity on lines sharing the authorization is within its maximum"
              }
            ]
          }
        ],
        "messages": {
          "PASS": "Authorization records match the required services and claim lines.",
          "FAIL": "Authorization records contain missing references or mismatched service, patient, status, dates, or quantity limits.",
          "UNABLE_TO_ASSESS": "Missing authorization information prevents a complete authorization record check.",
          "NOT_APPLICABLE": "No supplied lines require authorization under the policy."
        }
      }
