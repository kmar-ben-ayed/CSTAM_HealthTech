    "on_true": "PASS",
    "evidence_path": "/provider_id",
    "message": "Provider must be EDU-PROV-01."
  },
  "R017": {
    "kind": "expression",
    "schema_version": 1,
    "expression": {
      "op": "equals",
      "left": "diagnosis_code",
      "right": "DX-EDU-02"
    },
    "on_missing": "fail",
    "on_false": "fail",
    "on_true": "pass",
    "evidence_path": "diagnosis_code",
    "message": "only code 2 is accepted"
  }
